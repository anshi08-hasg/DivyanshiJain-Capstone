# Copy this to a .env file at the repo root (one already exists there) and
# fill in whichever provider you want to use. Leave everything blank to run
# fully offline against the built-in mock provider.

# anthropic | openai | groq | mock (default: mock if no key set below)
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (OpenAI-compatible API, https://api.groq.com/openai/v1). Get a key at
# console.groq.com. GROQ_MODEL must be a model that supports response_format
# json_object (openai/gpt-oss-120b does).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Only needed for the "Push to FigJam" button (writes real sticky notes to a
# FigJam board via the community figma-console-mcp server). Get this from
# Figma's token management page (Settings > Security); starts with "figd_".
FIGMA_ACCESS_TOKEN=

# local (default): spawns npx figma-console-mcp locally; requires Node.js,
#   Figma Desktop open with the target board, and the Desktop Bridge plugin
#   running (Plugins > Development > Figma Desktop Bridge). Only works when
#   this backend and Figma Desktop are on the same machine.
# cloud: connects over HTTPS to the community relay instead; needed if this
#   backend is hosted remotely (e.g. Railway). Pair once via the "Generate
#   pairing code" button / POST /api/figjam/pair. See FIGMA_CONNECT.md 7.1.
FIGJAM_MCP_MODE=

# Only needed if the frontend is deployed as its own separate Railway
# service (FIGMA_CONNECT.md section 8, Option B) rather than served by this
# same backend. Set to that frontend service's exact public URL to restrict
# CORS to it; leave blank to allow any origin (fine for local dev only).
FRONTEND_ORIGIN=
